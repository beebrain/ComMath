\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mathstyle}[2026/05/01 Modern Math Style (Muted Pastel, Rounded, Drop Shadow)]

%% tikz โหลดไว้เพราะ tcolorbox ที่ใช้วาดกล่องบทนิยามต้องพึ่ง ไม่ได้ใช้วาดรูปประกอบ
\RequirePackage{tikz}
\RequirePackage[most]{tcolorbox}
\tcbuselibrary{skins,breakable,theorems}
\usepackage{amsmath, amsthm, amssymb}
\usepackage{centernot}
\usepackage{fancybox} % ใช้สำหรับวาดกรอบวงรีโดยไม่พึ่ง tikz

%% ผลต่างสมมาตร ใช้ \symdiff แทน \Delta เปล่า เพราะ \Delta เป็น \mathord
%% จึงได้ระยะห่างแบบตัวแปร ไม่ใช่แบบตัวดำเนินการทวิภาคอย่าง \cup \cap
\newcommand{\symdiff}{\mathbin{\Delta}}

%% ─────────────── New Macros for Examples ───────────────
%% Macro สำหรับคำตอบ (ยกเลิกการวาดกรอบรูปสี่เหลี่ยม/วงรีล้อมรอบคำตอบ)
\newcommand{\mathoval}[1]{\ensuremath{\displaystyle #1}}

%% ─────────────── QED Symbol ───────────────
\renewcommand{\qedsymbol}{$\blacksquare$}

%% ─────────────── Solution Environment ───────────────
%% \solhere = วาง ∎ บนบรรทัดปัจจุบัน (ใช้ท้าย \item สุดท้ายเมื่อ solution จบด้วย list/สมการ
%% ไม่งั้น ∎ จะตกไปอยู่บรรทัดใหม่ชิดขวา) — ทำงานแบบเดียวกับ \qedhere ของ amsthm
\newif\ifsolqed@done
\newcommand{\solhere}{\unskip\nobreak\hfill\qedsymbol\global\solqed@donetrue}
\newenvironment{solution}{%
  \global\solqed@donefalse
  \par\vspace{0.8em}%
  \noindent\textbf{\color{black}วิธีทำ}\quad\ignorespaces
}{%
  \ifsolqed@done\else\hfill\qedsymbol\fi
  \par\vspace{1em}%
  \noindent\textcolor{gray!40}{\rule{\textwidth}{0.5pt}}%
  \par\vspace{1.5em}%
  \normalcolor
}

%% Environment สำหรับขั้นตอนวิธีทำ (เน้นกึ่งกลางและขยับย่อหน้าให้อ่านง่าย)
\newenvironment{solsteps}{%
  \vspace{0.3em}%
  \begin{list}{}{%
    \setlength{\topsep}{0.2em}%
    \setlength{\itemsep}{0.4em}%
    \setlength{\leftmargin}{2.5em}%
    \setlength{\rightmargin}{1.5em}%
    \setlength{\labelwidth}{0pt}%
    \setlength{\labelsep}{0pt}%
  }%
}{%
  \end{list}%
  \vspace{0.3em}%
}

