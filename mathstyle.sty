%% ─────────────── Base Style Template ───────────────
\tcbset{
  mathstylebase/.style={
    enhanced jigsaw,
    breakable,
    boxrule=0pt,          % Default no border
    arc=4pt,              % Rounded corners
    outer arc=4pt,
    left=12pt, right=12pt, top=10pt, bottom=10pt,
    before skip=14pt,
    after skip=14pt,
    fonttitle=\bfseries
  }
}

%% ── ทฤษฎีบท (thrm) — กล่องแถบหัวเข้ม "ทฤษฎีบท X.Y" (สไตล์เดียวกับนิยาม แต่สีน้ำเงิน) ──
%% renew ทับ amsthm thrm (จาก main.tex) — ตัวนับ thrm ยังใช้ร่วมกับ ex/prop/rem/cor/warning
\renewenvironment{thrm}[1][]{%
  \par\refstepcounter{thrm}%
  \def\@tsub{#1}%
  \ifx\@tsub\@empty\def\@tttl{}\else\def\@tttl{\quad #1}\fi
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=white,
    colframe=thrmBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=3pt, bottom=6pt,
    before skip=12pt, after skip=12pt,
    colbacktitle=thrmTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={ทฤษฎีบท~\thethrm\@tttl}
  ]%
  \def\[{\begin{center}$\displaystyle}%
  \def\]{$\end{center}}%
}{%
  \end{tcolorbox}%
}

%% ── หลักการ (principle) — กล่องแถบหัวเข้ม ใช้ตัวนับเดียวกับทฤษฎีบท ──
\renewenvironment{principle}[1][]{%
  \par\refstepcounter{principle}%
  \def\@prsub{#1}%
  \ifx\@prsub\@empty\def\@prttl{}\else\def\@prttl{\quad #1}\fi
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=white,
    colframe=thrmBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=3pt, bottom=6pt,
    before skip=12pt, after skip=12pt,
    colbacktitle=thrmTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={หลักการ~\theprinciple\@prttl}
  ]%
  \def\[{\begin{center}$\displaystyle}%
  \def\]{$\end{center}}%
}{%
  \end{tcolorbox}%
}

%% ── นิยาม (definition) — กล่องแถบหัวเข้ม "บทนิยาม X.Y: ชื่อ" (สไตล์ prinmath) ──
%% ใช้ตัวนับ thrm ร่วมกับ ทฤษฎีบท/ตัวอย่าง เลขจึงต่อเนื่องเหมือนเดิม; รองรับ \begin{definition}[ชื่อ]
\newenvironment{definition}[1][]{%
  \par\refstepcounter{defcnt}%
  \def\@dsub{#1}%
  \ifx\@dsub\@empty\def\@dttl{}\else\def\@dttl{\quad #1}\fi
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=white,
    colframe=defBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    before skip=12pt, after skip=12pt,
    colbacktitle=defTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={บทนิยาม~\thedefcnt\@dttl}
  ]%
  \def\[{\begin{center}$\displaystyle}%
  \def\]{$\end{center}}%
}{%
  \end{tcolorbox}%
}

%% ── ตัวอย่าง (ex) ───────────────────────────────
\tcolorboxenvironment{ex}{
  blanker,
  breakable,
  left=0pt,
  before skip=22pt,
  after skip=18pt
}

%% ── บทแทรก (prop) — กล่องแถบหัวเข้ม "บทแทรก X.Y" (สไตล์เดียวกับนิยาม) ──
\renewenvironment{prop}[1][]{%
  \par\refstepcounter{prop}%
  \def\@psub{#1}%
  \ifx\@psub\@empty\def\@pttl{}\else\def\@pttl{\quad #1}\fi
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=white,
    colframe=propBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    before skip=12pt, after skip=12pt,
    colbacktitle=propTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={บทแทรก~\theprop\@pttl}
  ]%
  \def\[{\begin{center}$\displaystyle}%
  \def\]{$\end{center}}%
}{%
  \end{tcolorbox}%
}

%% ── หมายเหตุ (rem) — กล่องแถบหัวเข้ม "หมายเหตุ" โดยไม่ใช้เลขกำกับ ──
\renewenvironment{rem}[1][]{%
  \par
  \def\@rsub{#1}%
  \ifx\@rsub\@empty\def\@rttl{}\else\def\@rttl{\quad #1}\fi
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=white,
    colframe=remBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    before skip=12pt, after skip=12pt,
    colbacktitle=remTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={หมายเหตุ\@rttl}
  ]%
  \def\[{\begin{center}$\displaystyle}%
  \def\]{$\end{center}}%
}{%
  \end{tcolorbox}%
}

%% ── บทสรุป (cor) ────────────────────────────────
\tcolorboxenvironment{cor}{
  mathstylebase,
  colback=white,
  coltitle=corTitle,
  colframe=corBar,
  toprule=4pt,
  leftrule=4pt,
  rightrule=0pt,
  bottomrule=0pt
}

%% ── คำเตือน (warning) ───────────────────────────
\tcolorboxenvironment{warning}{
  mathstylebase,
  colback=warnBg,
  coltitle=warnTitle,
  colframe=warnBar,
  toprule=4pt,
  leftrule=4pt,
  rightrule=0pt,
  bottomrule=0pt
}

%% ── แบบฝึกหัด (exercise) ────────────────────────
\tcolorboxenvironment{exercise}{
  blanker,
  breakable,
  left=0pt,
  before skip=14pt,
  after skip=14pt
}

%% ─────────────── Proof Environment — กล่องแถบหัวเข้ม "พิสูจน์" (สไตล์เดียวกับนิยาม) ───────────────
\renewenvironment{proof}[1][พิสูจน์]{%
  \par
  \begin{tcolorbox}[
    enhanced, breakable,
    colback=proofBg,
    colframe=proofBar,
    boxrule=0.5pt,
    arc=2pt, outer arc=2pt,
    left=10pt, right=10pt, top=8pt, bottom=8pt,
    before skip=10pt, after skip=10pt,
    colbacktitle=proofTitle,
    coltitle=white,
    fonttitle=\bfseries,
    title={#1}
  ]%
}{%
  \unskip\nobreak\hfill\qedsymbol
  \end{tcolorbox}%
}

